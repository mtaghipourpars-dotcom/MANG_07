{
  "name": "pvpt-executive-demo",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "PVPT executive demo with persistent SQLite storage",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "start:local": "node scripts/start-local.mjs",
    "build": "node scripts/validate-agent-skills.mjs",
    "lint": "node scripts/validate-agent-skills.mjs",
    "test": "npm run validate:skills && npm run test:unit && playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:demo": "playwright test",
    "validate:skills": "node scripts/validate-agent-skills.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
