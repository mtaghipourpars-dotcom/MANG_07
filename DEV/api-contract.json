{
  "version": 1,
  "basePath": "/api/total-demo",
  "dataClass": "DEMO_SYNTHETIC",
  "operationalStatus": "INTERNAL_SOURCE_REQUIRED",
  "scenarioIdPattern": "^S[0-9]{6}$",
  "scenarioStorage": {"env": "PVPT_TOTAL_DEMO_DB", "default": ".pvpt/total-demo.sqlite", "mode": "read-only"},
  "workflowStorage": {"env": "PVPT_DATABASE_PATH", "default": ".pvpt/demo.sqlite", "mode": "append-only action history", "isolation": ["workspace_id", "scenario_id"]},
  "routes": [
    {"method": "GET", "path": "/summary", "responseFields": ["data_class", "operationalStatus", "summary", "filters"]},
    {"method": "GET", "path": "/scenarios", "query": {"filters": ["anchor", "stage", "resource", "option", "profile", "variant", "gate", "decision", "execution", "outcome"], "variant": [0, 1], "limit": {"min": 1, "max": 100, "default": 20}, "offset": {"min": 0, "max": 1000000, "default": 0}}, "orderBy": ["id"], "responseFields": ["items", "total", "offset", "limit", "data_class"]},
    {"method": "GET", "path": "/scenarios/:id", "responseType": "scenarioDetail"},
    {"method": "GET", "path": "/scenarios/:id/relationships", "responseType": "scenarioRelationships", "sourceMode": "DERIVED_PRECOMPUTED_SCENARIO_BANK"},
    {"method": "GET", "path": "/executive", "responseFields": ["data_class", "sourceMode", "operationalStatus", "executive"]},
    {"method": "GET", "path": "/reservations", "workspace": "read-or-create", "responseFields": ["data_class", "engine", "now", "reservations", "attempts"]},
    {"method": "GET", "path": "/cases/:id", "workspace": "read-or-create", "responseType": "caseState"},
    {"method": "POST", "path": "/cases/:id/actions", "workspace": "existing-same-origin", "body": {"revision": "nonnegative-safe-integer", "action": "case-transition-action", "actor": "case-transition-role", "reason": "nonblank-string-max-1000", "verifier": "optional-simulation-label-max-160", "recorder": "optional-must-match-actor", "lesson": "optional-lesson-on-close-after-observation"}, "responseType": "caseState"},
    {"method": "POST", "path": "/cases/:id/reservations", "workspace": "existing-same-origin", "body": {"start_min": "safe-integer", "end_min": "safe-integer", "expires_at": "safe-integer", "now": "optional-safe-integer", "owner": "nonblank-string-max-120", "decision_revision": "optional-positive-safe-integer"}, "responseType": "reservationResult"}
  ],
  "types": {
    "scenario": ["id", "anchor", "stage", "resource", "option", "profile", "variant", "gate", "decision", "execution", "outcome", "data_class"],
    "scenarioDetail": {"extends": "scenario", "fields": ["anchor_details", "event", "effect", "directEffects", "optionSideEffects", "precomputedBankEvidence"]},
    "scenarioRelationships": {
      "fields": ["scenarioId", "data_class", "sourceMode", "operationalStatus", "challenge", "options", "links", "unresolved"],
      "cohortKeys": ["anchor", "stage", "profile", "variant"],
      "challengeNullable": true,
      "optionFields": ["scenarioId", "code", "gate", "decision", "challengeId"],
      "linkFields": ["challengeId", "commitmentId", "node", "kind", "status", "scenarioId", "optionCode", "physicalOrderId", "source", "values"],
      "linkKinds": ["DIRECT", "SIDE_EFFECT"],
      "physicalOrderId": null,
      "sourceFields": ["table", "scenarioId", "node"],
      "valueFields": ["baseline", "withoutAction", "proposed", "currentForecast", "observed"],
      "unresolvedFields": ["node", "scenarioId", "source", "status"]
    },
    "anchor_details": ["id", "family", "provenance"],
    "event": ["scenario", "sequence", "actor", "action", "status"],
    "effect": {"fields": ["scenario", "node", "baseline", "without_action", "proposed", "current_forecast", "observed"], "nullable": ["without_action", "proposed", "current_forecast", "observed"]},
    "caseState": ["scenarioId", "data_class", "actorMode", "enterpriseAuthStatus", "revision", "status", "history", "allowedActions", "approvedSnapshot", "observations", "lessons", "reservations", "reservationAttempts", "remainingRiskStatus"],
    "lesson": {"text":"nonblank-string-max-1000","applicability":"nonblank-string-max-1000"},
    "history": ["revision", "action", "actor", "status", "reason", "at"],
    "allowedActions": ["action", "actor"],
    "reservationResult": ["id", "status", "decisionRevision", "conflictingOrders", "conflicts"]
  },
  "errors": {
    "400": ["invalid_scenario_query", "invalid_case_action", "invalid_reservation_query", "invalid_reservation_request", "invalid_json", "invalid_lesson"],
    "403": ["cross_origin_write", "action_not_allowed", "self_verification_forbidden", "recorder_mismatch", "approval_required"],
    "404": ["scenario_not_found", "not_found"],
    "409": ["revision_conflict", "scenario_source_changed", "lesson_requires_observation", "reservation_conflict", "approval_required"],
    "413": ["payload_too_large"],
    "428": ["workspace_required"],
    "500": ["internal_error"],
    "503": ["scenario_bank_unavailable", "database_unavailable"]
  },
  "workflow": {
    "initial": {"status": "DRAFT", "revision": 0},
    "actorsAreDemoRoles": true,
    "transitions": [
      {"from": "DRAFT", "action": "REPORT", "actor": "EXPERT", "to": "REPORTED"},
      {"from": "REPORTED", "action": "SCOPE", "actor": "OWNER", "to": "SCOPED"},
      {"from": "SCOPED", "action": "ASSESS", "actor": "ASSESSOR", "to": "ASSESSED"},
      {"from": "ASSESSED", "action": "APPROVE", "actor": "DECIDER", "to": "APPROVED", "requiresAll": {"gate": ["FEASIBLE"], "decision": ["APPROVED"]}},
      {"from": "ASSESSED", "action": "DECLINE", "actor": "DECIDER", "to": "DECLINED"},
      {"from": "APPROVED", "action": "EXECUTE", "actor": "OWNER", "to": "EXECUTED"},
      {"from": "EXECUTED", "action": "OBSERVE", "actor": "OWNER", "to": "OBSERVED", "requiresAll": {"outcome": ["VERIFIED", "PARTIALLY_VERIFIED"]}},
      {"from": "OBSERVED", "action": "CLOSE", "actor": "EXPERT", "to": "CLOSED"},
      {"from": "DECLINED", "action": "CLOSE", "actor": "EXPERT", "to": "CLOSED"}
    ]
  }
}
