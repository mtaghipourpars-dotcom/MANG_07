{
  "version": 2,
  "basePath": "/api/total-demo",
  "dataClass": "DEMO_SYNTHETIC",
  "operationalStatus": "INTERNAL_SOURCE_REQUIRED",
  "actorMode": "DEMO_SIMULATED_ROLE",
  "enterpriseAuthStatus": "BLOCKED_INTERNAL_SOURCE_REQUIRED",
  "recorderPolicy": "SERVER_DERIVED_NEVER_TRUST_CLIENT",
  "clockPolicy": "SERVER_CONTROLLED_SIMULATION_CLOCK",
  "portfolioScope": "SHARED_ACROSS_AUTHORIZED_SESSIONS",
  "scenarioIdPattern": "^S[0-9]{6}$",
  "portfolioIdPattern": "^[A-Z0-9_-]{3,40}$",
  "scenarioStorage": {"env": "PVPT_TOTAL_DEMO_DB", "default": ".pvpt/total-demo.sqlite", "mode": "read-only"},
  "workflowStorage": {"env": "PVPT_DATABASE_PATH", "default": ".pvpt/demo.sqlite", "mode": "append-only action history and live SQLite transactions", "isolation": ["workspace_id", "scenario_id", "portfolio_id"]},
  "routes": [
    {"method": "GET", "path": "/summary", "responseFields": ["data_class", "actorMode", "enterpriseAuthStatus", "operationalStatus", "summary", "filters"]},
    {"method": "GET", "path": "/scenarios", "query": {"filters": ["anchor", "stage", "resource", "option", "profile", "variant", "gate", "decision", "execution", "outcome"], "variant": [0, 1], "limit": {"min": 1, "max": 100, "default": 20}, "offset": {"min": 0, "max": 1000000, "default": 0}}, "orderBy": ["id"], "responseFields": ["items", "total", "offset", "limit", "data_class"]},
    {"method": "GET", "path": "/scenarios/:id", "responseType": "scenarioDetail"},
    {"method": "GET", "path": "/executive", "sourceMode": "READ_ONLY_PRECOMPUTED_SCENARIO_BANK", "responseFields": ["data_class", "sourceMode", "actorMode", "enterpriseAuthStatus", "operationalStatus", "executive"]},
    {"method": "GET", "path": "/finance/trace", "sourceMode": "LIVE_SQLITE_BANK_QUERY", "responseFields": ["data_class", "sourceMode", "operationalStatus", "costControl", "cashDag", "fundingGate", "economicOutputs"]},
    {"method": "POST", "path": "/finance/verify-posting", "workspace": "same-origin", "body": {"document": "nonblank-string-max-80", "period": "YYYY-MM", "currency": "optional-string", "confirmedByFinance": "boolean"}, "responseFields": ["data_class", "sourceMode", "operationalStatus", "accepted", "posting", "plan"]},
    {"method": "GET", "path": "/governance/queue", "sourceMode": "LIVE_SQLITE_BANK_QUERY", "query": {"asOfMinute": "optional-safe-integer"}, "responseFields": ["data_class", "sourceMode", "actorMode", "enterpriseAuthStatus", "operationalStatus", "asOfMinute", "authorities", "ceoQueue", "highRiskWatch", "deputyRouting", "events"]},
    {"method": "POST", "path": "/governance/evaluate", "workspace": "same-origin", "body": {"caseId": "nonblank-string", "actor": "nonblank-string", "asOfMinute": "optional-safe-integer"}, "responseFields": ["data_class", "sourceMode", "actorMode", "enterpriseAuthStatus", "allowed", "caseId", "actor", "ceiling", "amount", "assignment"]},
    {"method": "GET", "path": "/cases/:id/links", "workspace": "read-or-create", "responseFields": ["data_class", "scenarioId", "issueId", "optionId", "links"]},
    {"method": "POST", "path": "/cases/:id/links", "workspace": "existing-same-origin", "body": {"commitmentId": "anchor::node", "reviewStatus": "OBSERVED|CONFIRMED|UNKNOWN|NO_EFFECT", "evidenceRef": "nullable-string-max-160", "actor": "optional-role"}, "responseFields": ["data_class", "saved", "links"]},
    {"method": "GET", "path": "/commitments/:commitmentId/links", "workspace": "read-or-create", "responseFields": ["data_class", "commitmentId", "anchor", "node", "effectType", "total", "limit", "offset", "donorImpactedScenarioCount", "links", "lessons"]},
    {"method": "GET", "path": "/issues/:id/commitments", "workspace": "read-or-create", "responseFields": ["data_class", "scenarioId", "issueId", "optionId", "anchor", "stage", "resource", "option", "directCommitments", "donorSideEffectCommitments", "commitments", "lessons"]},
    {"method": "GET", "path": "/clock", "workspace": "read-or-create", "query": {"portfolio_id": "optional-portfolio-id"}, "responseFields": ["data_class", "portfolioId", "currentMinute", "mode", "updatedAt"]},
    {"method": "POST", "path": "/clock/advance", "workspace": "existing-same-origin", "body": {"portfolio_id": "optional-portfolio-id", "minute": "nonnegative-safe-integer"}, "responseFields": ["data_class", "portfolioId", "currentMinute", "mode", "updatedAt"]},
    {"method": "GET", "path": "/reservations", "workspace": "read-or-create", "query": {"portfolio_id": "optional-portfolio-id", "resource": "optional-string"}, "forbiddenQueryFields": ["now"], "responseFields": ["data_class", "engine", "portfolioId", "clock", "serverNow", "reservations", "attempts"]},
    {"method": "GET", "path": "/cases/:id", "workspace": "read-or-create", "responseType": "caseState"},
    {"method": "POST", "path": "/cases/:id/actions", "workspace": "existing-same-origin", "body": {"revision": "nonnegative-safe-integer", "action": "case-transition-action", "actor": "case-transition-role", "reason": "nonblank-string-max-1000", "verifier": "optional-independent-verifier", "evidenceVersion": "optional-positive-safe-integer", "evidenceRef": "optional-nullable-string-max-160", "reuseCondition": "optional-string-max-500", "observedOverrides": "optional-array-requiring-evidenceRef-on-OBSERVE"}, "forbiddenBodyFields": ["recorder"], "recorderPolicy": "SERVER_DERIVED_NEVER_TRUST_CLIENT", "responseType": "caseState"},
    {"method": "POST", "path": "/cases/:id/verifications", "workspace": "existing-same-origin", "body": {"kind": "OPERATIONAL|FINANCIAL|OUTCOME", "targetRevision": "positive-safe-integer", "decisionRevision": "optional-positive-safe-integer", "verifier": "nonblank-string-max-160", "documentRef": "optional-nullable-string", "period": "optional-nullable-YYYY-MM", "evidenceRef": "optional-nullable-string"}, "forbiddenBodyFields": ["recorder"], "recorderPolicy": "SERVER_DERIVED_NEVER_TRUST_CLIENT", "responseFields": ["data_class", "verification", "case"]},
    {"method": "GET", "path": "/lessons", "workspace": "read-or-create", "query": {"scenarioId": "optional-scenario-id", "commitmentId": "optional-commitment-id", "anchor": "optional-anchor-id"}, "responseFields": ["data_class", "scenarioId", "anchor", "items"]},
    {"method": "POST", "path": "/cases/:id/lessons", "workspace": "existing-same-origin", "body": {"closureType": "OUTCOME_BASED_LESSON|DECLINED_CLOSURE_NOTE", "reuseCondition": "nonblank-string-max-500", "summary": "nonblank-string-max-1000", "evidenceRef": "optional-nullable-string", "actor": "optional-role"}, "responseFields": ["data_class", "lesson", "case"]},
    {"method": "POST", "path": "/cases/:id/reservations", "workspace": "existing-same-origin", "body": {"portfolio_id": "optional-portfolio-id", "start_min": "safe-integer", "end_min": "safe-integer", "expires_at": "safe-integer", "owner": "nonblank-string-max-120", "decision_revision": "optional-positive-safe-integer"}, "forbiddenBodyFields": ["now"], "responseType": "reservationResult"}
  ],
  "types": {
    "scenario": ["id", "anchor", "stage", "resource", "option", "profile", "variant", "gate", "decision", "execution", "outcome", "data_class"],
    "scenarioDetail": {"extends": "scenario", "fields": ["anchor_details", "event", "effect", "directEffects", "optionSideEffects", "links", "precomputedBankEvidence"]},
    "anchor_details": ["id", "family", "provenance"],
    "event": ["scenario", "sequence", "actor", "action", "status"],
    "effect": {"fields": ["scenario", "node", "baseline", "without_action", "proposed", "current_forecast", "observed"], "nullable": ["without_action", "proposed", "current_forecast", "observed"]},
    "commitmentLink": ["scenarioId", "commitmentId", "issueId", "optionId", "effectType", "donorImpacted", "reviewStatus", "version", "evidenceRef"],
    "caseState": ["scenarioId", "data_class", "actorMode", "enterpriseAuthStatus", "revision", "status", "history", "allowedActions", "approvedSnapshot", "observations", "verifications", "lessons", "reservations", "reservationAttempts", "primaryChainRiskStatus", "donorSideEffectRiskStatus", "remainingRiskStatus", "observedDelayConfirmed", "unknownNodes"],
    "history": ["revision", "action", "actor", "status", "reason", "at"],
    "allowedActions": ["action", "actor"],
    "lesson": ["id", "scenario_id", "anchor", "closure_type", "decision_revision", "observation_revision", "evidence_ref", "reuse_condition", "summary", "actor", "created_at"],
    "reservationResult": ["id", "portfolioId", "serverNow", "status", "decisionRevision", "conflictingOrders", "conflicts"]
  },
  "errors": {
    "400": ["invalid_scenario_query", "invalid_case_action", "invalid_reservation_query", "invalid_reservation_request", "invalid_reservation_window", "invalid_portfolio_id", "invalid_clock_request", "clock_cannot_rewind", "client_time_forbidden", "client_recorder_forbidden", "invalid_commitment_id", "invalid_link_query", "invalid_link_request", "evidence_ref_required", "invalid_verification_request", "invalid_lesson_query", "invalid_lesson_request", "invalid_posting_request", "invalid_governance_query", "invalid_governance_request", "invalid_json"],
    "403": ["cross_origin_write", "action_not_allowed", "self_verification_forbidden", "approval_required", "authority_exceeded", "assignment_expired_or_unassigned"],
    "404": ["scenario_not_found", "commitment_not_found", "posting_not_found", "governance_case_not_found", "not_found"],
    "409": ["revision_conflict", "scenario_source_changed", "reservation_conflict", "stale_evidence_version", "observation_required_for_lesson", "decline_required_for_note"],
    "413": ["payload_too_large"],
    "422": ["invalid_financial_evidence"],
    "428": ["workspace_required"],
    "500": ["internal_error"],
    "503": ["scenario_bank_unavailable", "database_unavailable", "enterprise_authority_required"]
  },
  "workflow": {
    "initial": {"status": "DRAFT", "revision": 0},
    "actorsAreDemoRoles": true,
    "enterpriseAuthStatus": "BLOCKED_INTERNAL_SOURCE_REQUIRED",
    "recorderPolicy": "SERVER_DERIVED_NEVER_TRUST_CLIENT",
    "transitions": [
      {"from": "DRAFT", "action": "REPORT", "actor": "EXPERT", "to": "REPORTED"},
      {"from": "REPORTED", "action": "SCOPE", "actor": "OWNER", "to": "SCOPED"},
      {"from": "SCOPED", "action": "ASSESS", "actor": "ASSESSOR", "to": "ASSESSED"},
      {"from": "ASSESSED", "action": "APPROVE", "actor": "DECIDER", "to": "APPROVED", "requiresAll": {"gate": ["FEASIBLE"], "decision": ["APPROVED"]}},
      {"from": "ASSESSED", "action": "DECLINE", "actor": "DECIDER", "to": "DECLINED"},
      {"from": "APPROVED", "action": "EXECUTE", "actor": "OWNER", "to": "EXECUTED"},
      {"from": "EXECUTED", "action": "OBSERVE", "actor": "OWNER", "to": "OBSERVED", "requiresAll": {"outcome": ["VERIFIED", "PARTIALLY_VERIFIED"]}},
      {"from": "OBSERVED", "action": "CLOSE", "actor": "EXPERT", "to": "CLOSED"},
      {"from": "DECLINED", "action": "CLOSE", "actor": "EXPERT", "to": "CLOSED"}
    ]
  }
}
