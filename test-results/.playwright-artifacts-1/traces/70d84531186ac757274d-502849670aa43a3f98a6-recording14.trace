96px}.layout-main{direction:rtl}.bottom-grid{grid-template-columns:minmax(0,1fr)}}\n@media(max-width:580px){.topbar{height:56px}.brandname{font-size:21px}.shell{min-height:calc(100vh - 56px)}.hero{padding:12px}.hero h1{font-size:18px}.hero p{font-size:9px}.kpis{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.kpi{min-height:100px;padding:9px}.kpi-number{font-size:25px}.products-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-end{display:none}.layout-main{direction:rtl}.executive-metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n\n/* Main-screen reference lock: stable desktop composition, faithful hierarchy and responsive collapse. */\n#homePage .hero{margin-top:0}\n#homePage .kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr))}\n#homePage .layout-main{display:grid;grid-template-columns:minmax(0,.98fr) minmax(0,1.02fr);direction:ltr;align-items:stretch}\n#homePage .layout-main>.panel,#homePage .layout-main>.right-stack{direction:rtl}\n#homePage .right-stack{display:flex;flex-direction:column;min-width:0}\n#homePage .portfolio-panel{order:0}\n#homePage .executive-metrics{order:1}\n#homePage .bottom-grid{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(0,1fr) minmax(230px,.65fr)}\n#homePage .bottom-grid .decision-panel{grid-column:1}\n#homePage .bottom-grid .project-panel{grid-column:2}\n#homePage .bottom-grid .latest-panel{grid-column:3}\n#homePage .bottom-grid .flow-panel{display:none}\n#homePage .products-grid{grid-template-columns:repeat(6,minmax(0,1fr))}\n#homePage .panel,#homePage .kpi{min-width:0}\n#homePage .project-table{width:100%}\n@media(max-width:1250px){\n #homePage .kpis{grid-template-columns:repeat(3,minmax(0,1fr))}\n #homePage .layout-main{grid-template-columns:minmax(0,1fr);direction:rtl}\n #homePage .bottom-grid{grid-template-columns:repeat(2,minmax(0,1fr))}\n #homePage .bottom-grid .decision-panel,#homePage .bottom-grid .project-panel,#homePage .bottom-grid .latest-panel{grid-column:auto}\n #homePage .products-grid{grid-template-columns:repeat(3,minmax(0,1fr))}\n}\n@media(max-width:850px){\n #homePage .layout-main,#homePage .right-stack,#homePage .bottom-grid{grid-template-columns:minmax(0,1fr)}\n #homePage .bottom-grid{display:grid}\n #homePage .bottom-grid .decision-panel,#homePage .bottom-grid .project-panel,#homePage .bottom-grid .latest-panel{grid-column:auto}\n #homePage .products-grid{grid-template-columns:repeat(2,minmax(0,1fr))}\n}\n@media(max-width:580px){\n #homePage .kpis{grid-template-columns:repeat(2,minmax(0,1fr))}\n #homePage .hero h1{font-size:18px}\n #homePage .executive-metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}\n}\n"],"\n",["LINK",{"rel":"stylesheet","href":"app-engine.css"}],"\n",["LINK",{"rel":"stylesheet","href":"ui-redesign.css"}],"\n\n",["STYLE",{},"\n/* Regression fix: keep the dashboard within narrow viewports. */\n@media (max-width: 850px) {\n  html, body { width: 100%; max-width: 100%; overflow-x: clip; }\n  .shell, .workspace, #homePage, .layout-main, .right-stack, .bottom-grid,\n  .panel, .hero, .kpis { min-width: 0; max-width: 100%; box-sizing: border-box; }\n  .workspace { padding-left: 10px; padding-right: 10px; }\n  .layout-main, .right-stack, .bottom-grid { grid-template-columns: minmax(0, 1fr); }\n  .products-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .project-table { width: 100%; }\n  .table-wrap { max-width: 100%; overflow-x: auto; }\n}\n@media (max-width: 580px) {\n  .topbar { width: 100%; min-width: 0; }\n  .top-left, .top-right { min-width: 0; }\n  .brandname { max-width: 42vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  .sidebar nav { max-width: 100%; }\n  .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .hero { gap: 8px; }\n  .hero-copy, .hero-end { min-width: 0; }\n  .panel-head { min-width: 0; flex-wrap: wrap; }\n}\n"],"\n\n",["STYLE",{},"\n/* Pixel-exact alignment with demo/main.png (1536x1024 reference) */\n:root {\n  --ref-bg: #eef4fa;\n  --ref-navy-top: #172738;\n  --ref-navy-side: #1a2a3a;\n  --ref-navy-side-bot: #11202f;\n  --ref-ink: #0d2b4e;\n  --ref-muted: #567089;\n  --ref-border: #dbe6f0;\n  --ref-red: #ec1c2e;\n  --ref-orange: #f58220;\n  --ref-amber: #f5b400;\n  --ref-green: #169c59;\n  --ref-blue: #1664b0;\n  --ref-purple: #6b1cb0;\n}\nbody {\n  background: var(--ref-bg) !important;\n  color: var(--ref-ink) !important;\n  font-family: 'Vazirmatn', Tahoma, Arial, sans-serif !important;\n  margin: 0;\n}\n/* Topbar */\n.topbar {\n  height: 58px !important;\n  padding: 0 22px !important;\n  background: linear-gradient(90deg, #1b2d40 0%, #1d354c 55%, #162637 100%) !important;\n  border-bottom: 1px solid #2b435a !important;\n  box-shadow: none !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n  direction: ltr !important;\n}\n.topbar .brand {\n  display: flex !important;\n  align-items: center !important;\n  gap: 10px !important;\n  direction: ltr !important;\n}\n.topbar .brandmark {\n  width: 38px !important;\n  height: 34px !important;\n  background: linear-gradient(135deg, #ed1c24 0 54%, transparent 55%), linear-gradient(135deg, transparent 44%, #d8e2ec 45% 100%) !important;\n  clip-path: polygon(32% 0, 100% 0, 68% 100%, 0 100%) !important;\n  filter: none !important;\n}\n.topbar .brandname {\n  font-size: 28px !important;\n  font-weight: 900 !important;\n  letter-spacing: 0.8px !important;\n  color: #fff !important;\n  line-height: 1 !important;\n}\n.topbar .brandname small {\n  display: block !important;\n  font-size: 7.5px !important;\n  font-weight: 700 !important;\n  letter-spacing: 1.1px !important;\n  color: #cbd8e6 !important;\n  margin-top: 3px !important;\n}\n.topbar .top-right {\n  display: flex !important;\n  align-items: center !important;\n  gap: 16px !important;\n  direction: rtl !important;\n  color: #dbe7f3 !important;\n  font-size: 12px !important;\n}\n.topbar .user {\n  display: flex !important;\n  align-items: center !important;\n  gap: 10px !important;\n  border-right: none !important;\n  border-left: 1px solid #ffffff26 !important;\n  padding-right: 0 !important;\n  padding-left: 16px !important;\n}\n.topbar .avatar {\n  width: 34px !important;\n  height: 34px !important;\n  border-radius: 50% !important;\n  background: #d8e3ee !important;\n  color: #1c354d !important;\n  display: grid !important;\n  place-items: center !important;\n}\n.topbar .notif-bell {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 30px;\n  height: 30px;\n  color: #e3edf7;\n  font-size: 17px;\n  border-left: 1px solid #ffffff26;\n  padding-left: 14px;\n}\n.topbar .notif-badge {\n  position: absolute;\n  top: 0px;\n  right: -2px;\n  background: #ed1c2e;\n  color: #fff;\n  font-size: 9px;\n  font-weight: 900;\n  width: 15px;\n  height: 15px;\n  border-radius: 50%;\n  display: grid;\n  place-items: center;\n}\n.topbar .top-clock {\n  font-size: 12px;\n  color: #d6e3f0;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n.topbar .demo-pill {\n  font-size: 9px !important;\n  padding: 3px 8px !important;\n  background: rgba(255, 241, 216, 0.14) !important;\n  color: #ffd591 !important;\n  border: 1px solid rgba(248, 211, 138, 0.35) !important;\n}\n\n/* Shell & Sidebar */\n.shell {\n  display: grid !important;\n  grid-template-columns: 178px minmax(0, 1fr) !important;\n  min-height: calc(100vh - 58px) !important;\n  direction: ltr !important;\n}\n.sidebar {\n  background: linear-gradient(180deg, #1b2b3a 0%, #122130 100%) !important;\n  padding: 28px 0 16px !important;\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 4px !important;\n  border-left: none !important;\n  border-right: 1px solid #263a4f !important;\n  direction: rtl !important;\n  position: relative !important;\n  overflow: hidden !important;\n  height: auto !important;\n}\n.sidebar .nav {\n  border-radius: 0 !important;\n  padding: 12px 16px !important;\n  min-height: 46px !important;\n  font-size: 12.5px !important;\n  font-weight: 600 !important;\n  color: #c8d6e3 !important;\n  gap: 11px !important;\n  border: none !important;\n}\n.sidebar .nav .ico {\n  width: 24px !important;\n  height: 24px !important;\n  background: transparent !important;\n  font-size: 18px !important;\n  color: #9ab0c4 !important;\n}\n.sidebar .nav.active {\n  background: linear-gradient(90deg, rgba(25, 92, 148, 0.55), rgba(31, 112, 176, 0.85)) !important;\n  color: #fff !important;\n  box-shadow: inset 4px 0 0 #38c6f4 !important;\n}\n.sidebar .nav.active .ico {\n  color: #fff !important;\n}\n.sidebar-turbine-art {\n  margin-top: auto;\n  padding: 16px 14px 6px;\n  position: relative;\n  color: #93a8bc;\n  text-align: center;\n}\n.sidebar-turbine-art svg.turbine-wireframe {\n  width: 150px;\n  height: 125px;\n  opacity: 0.26;\n  display: block;\n  margin: 0 auto 6px;\n}\n.sidebar-slogan {\n  font-size: 11px;\n  color: #9eb3c6;\n  line-height: 1.65;\n  margin-bottom: 14px;\n}\n.sidebar-brand-foot {\n  text-align: left;\n  direction: ltr;\n  padding: 8px 4px 0;\n  border-top: 1px solid rgba(255,255,255,0.08);\n  font-size: 14px;\n  font-weight: 900;\n  color: #cbd9e6;\n  letter-spacing: 0.5px;\n}\n.sidebar-brand-foot small {\n  display: block;\n  font-size: 7px;\n  font-weight: 600;\n  color: #8298ad;\n  letter-spacing: 0.9px;\n}\n\n/* Workspace */\n.workspace {\n  direction: rtl !important;\n  padding: 10px 16px 18px !important;\n  max-width: none !important;\n  background: #edf4fa !important;\n}\n\n/* Hero Banner */\n#homePage .hero {\n  min-height: 104px !important;\n  padding: 14px 26px !important;\n  border-radius: 14px !important;\n  margin-bottom: 12px !important;\n  border: 1px solid #d5e3ef !important;\n  background: linear-gradient(90deg, #c6d7e6 0%, #dce8f2 32%, #f5f9fd 68%, #ffffff 100%) !important;\n  box-shadow: 0 2px 8px rgba(15, 42, 74, 0.04) !important;\n  position: relative !important;\n  overflow: hidden !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n}\n#homePage .hero:before { display: none !important; }\n#homePage .hero:after {\n  content: '' !important;\n  position: absolute !important;\n  inset: 0 28% 0 14% !important;\n  background: url('https://mapnagenerator.com/images/Products/tng4zqxf.myk.webp') center 46% / cover no-repeat !important;\n  opacity: 0.55 !important;\n  mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 78%, transparent 100%) !important;\n  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 78%, transparent 100%) !important;\n  pointer-events: none !important;\n}\n#homePage .hero h1 {\n  font-size: 23px !important;\n  font-weight: 900 !important;\n  color: #0d2d52 !important;\n  margin: 0 0 4px 0 !important;\n}\n#homePage .hero p {\n  font-size: 12.5px !important;\n  font-weight: 700 !important;\n  letter-spacing: 1.1px !important;\n  color: #1c3d63 !important;\n  margin: 0 !important;\n  text-transform: uppercase !important;\n}\n#homePage .hero-end {\n  background: transparent !important;\n  border: none !important;\n  padding: 0 !important;\n  font-size: 19px !important;\n  font-weight: 900 !important;\n  color: #102e4a !important;\n  line-height: 1.45 !important;\n  text-align: left !important;\n}\n\n/* 5 Top KPI Cards */\n/* In RTL grid, column 1 is rightmost and column 5 is leftmost */\n#homePage .kpis {\n  display: grid !important;\n  grid-template-columns: repeat(5, minmax(0, 1fr)) !important;\n  gap: 11px !important;\n  margin-bottom: 12px !important;\n  direction: rtl !important;\n}\n#homePage .kpi {\n  min-height: 112px !important;\n  padding: 10px 14px !important;\n  border-radius: 8px !important;\n  background: #fff !important;\n  border: 1px solid #dce6f1 !important;\n  box-shadow: 0 2px 6px rgba(15, 42, 74, 0.03) !important;\n  display: flex !important;\n  flex-direction: column !important;\n  justify-content: space-between !important;\n}\n#homePage .kpi.kpi-var-highlight {\n  border: 1.5px solid #ed1c2e !important;\n  background: linear-gradient(180deg, #fff9fa 0%, #fff 100%) !important;\n}\n#homePage .kpi.kpi-orange-tint {\n  background: linear-gradient(180deg, #fffaf5 0%, #fff 100%) !important;\n  border-color: #f5dec8 !important;\n}\n#homePage .kpi.kpi-amber-tint {\n  background: linear-gradient(180deg, #fffdf4 0%, #fff 100%) !important;\n  border-color: #f3e5b8 !important;\n}\n#homePage .kpi.kpi-blue-tint {\n  background: linear-gradient(180deg, #f6faff 0%, #fff 100%) !important;\n  border-color: #d2e3f3 !important;\n}\n#homePage .kpi.kpi-purple-tint {\n  background: linear-gradient(180deg, #fbf7ff 0%, #fff 100%) !important;\n  border-color: #e6d4f7 !important;\n}\n#homePage .kpi-head-title {\n  font-size: 12.5px;\n  font-weight: 900;\n  text-align: center;\n  color: var(--kpi-title-color, #0d2d52);\n  margin-bottom: 2px;\n}\n#homePage .kpi-main-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 2px 4px;\n}\n#homePage .kpi-primary-metric {\n  text-align: center;\n  flex: 1;\n}\n#homePage .kpi-primary-metric .big-num {\n  font-size: 29px;\n  font-weight: 900;\n  line-height: 1.05;\n  color: var(--accent, #0d2d52);\n  display: block;\n}\n#homePage .kpi-primary-metric .sub-unit {\n  font-size: 11px;\n  font-weight: 700;\n  color: #1e3a56;\n  display: block;\n  margin-top: 2px;\n}\n#homePage .kpi-side-visual {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 2px;\n}\n#homePage .kpi-foot-note {\n  font-size: 10.5px;\n  font-weight: 800;\n  text-align: left;\n  color: var(--accent, #567089);\n  margin-top: 2px;\n}\n\n/* Middle Section: Left Risk Map + Right Portfolio & Macro Indicators */\n#homePage .layout-main {\n  display: grid !important;\n  grid-template-columns: minmax(0, 0.96fr) minmax(0, 1.04fr) !important;\n  gap: 12px !important;\n  margin-bottom: 12px !important;\n  direction: ltr !important;\n  align-items: stretch !important;\n}\n#homePage .layout-main > .panel,\n#homePage .layout-main > .right-stack {\n  direction: rtl !important;\n}\n#homePage .panel {\n  border-radius: 8px !important;\n  border: 1px solid #d8e5f1 !important;\n  box-shadow: 0 2px 6px rgba(15, 42, 74, 0.03) !important;\n  background: #fff !important;\n}\n#homePage .panel-head {\n  min-height: 38px !important;\n  padding: 8px 14px !important;\n  background: linear-gradient(90deg, #f8fbff, #eef5fb) !important;\n  border-bottom: 1px solid #e5eef6 !important;\n}\n#homePage .panel-head h2 {\n  font-size: 14px !important;\n  font-weight: 900 !important;\n  color: #0b2d53 !important;\n}\n\n/* Risk Chart Layout with right-side legend column matching main.png */\n.risk-map-layout {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 156px;\n  gap: 10px;\n  align-items: stretch;\n  direction: ltr;\n}\n.risk-legend-box {\n  direction: rtl;\n  background: #f9fbfd;\n  border: 1px solid #e5eef6;\n  border-radius: 6px;\n  padding: 10px 11px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  font-size: 10.5px;\n}\n.risk-legend-box h4 {\n  margin: 0 0 7px;\n  font-size: 11px;\n  font-weight: 900;\n  color: #123358;\n}\n.status-legend-list {\n  display: grid;\n  gap: 6px;\n  padding-bottom: 9px;\n  border-bottom: 1px solid #e3ecf4;\n}\n.status-legend-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  font-size: 10.5px;\n  color: #244260;\n}\n.status-legend-item .lbl {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n.status-legend-item .dot-i {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  display: inline-block;\n}\n.status-legend-item b {\n  font-weight: 900;\n  color: #0d2b4e;\n}\n.size-legend-list {\n  display: grid;\n  gap: 6px;\n  margin-top: 6px;\n}\n.size-legend-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 9.5px;\n  color: #49657f;\n}\n.size-legend-item .gray-c {\n  background: #bfc9d4;\n  border-radius: 50%;\n  display: inline-block;\n  flex-shrink: 0;\n}\n\n/* Portfolio 6 cards */\n#homePage .products-grid {\n  display: grid !important;\n  grid-template-columns: repeat(6, minmax(0, 1fr)) !important;\n  gap: 8px !important;\n}\n#homePage .product {\n  border-radius: 6px !important;\n  padding: 7px 6px !important;\n  background: #f9fbfd !important;\n  border: 1px solid #e1ebf4 !important;\n  text-align: center !important;\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n}\n#homePage .product-visual {\n  width: 100% !important;\n  height: 72px !important;\n  border-radius: 5px !important;\n  background: linear-gradient(180deg, #eef4f9, #fff) !important;\n  display: grid !important;\n  place-items: center !important;\n  overflow: hidden !important;\n}\n#homePage .product-visual img {\n  width: 100% !important;\n  height: 100% !important;\n  object-fit: contain !important;\n  display: block !important;\n}\n#homePage .product-name {\n  font-size: 10px !important;\n  font-weight: 800 !important;\n  color: #103257 !important;\n  min-height: 30px !important;\n  line-height: 1.45 !important;\n  margin-top: 6px !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n}\n.prod-status-badge {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 2px;\n  margin-top: 4px;\n  font-size: 9px;\n  font-weight: 800;\n}\n.prod-circle {\n  width: 17px;\n  height: 17px;\n  border-radius: 50%;\n  display: grid;\n  place-items: center;\n  color: #fff;\n  font-size: 10px;\n  font-weight: 900;\n}\n\n/* Macro Indicators (شاخص‌های کلان) */\n#homePage .executive-metrics {\n  margin-top: 0 !important;\n}\n#homePage .executive-metric-grid {\n  display: grid !important;\n  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;\n  gap: 8px !important;\n  padding: 8px 11px 10px !important;\n}\n#homePage .executive-metric {\n  border: 1px solid #e2ecf5 !important;\n  border-radius: 6px !important;\n  padding: 7px 8px !important;\n  background: #fff !important;\n  display: flex !important;\n  flex-direction: column !important;\n  justify-content: space-between !important;\n}\n.exec-metric-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 4px;\n}\n.exec-metric-top .m-title {\n  font-size: 10px;\n  font-weight: 800;\n  color: #163759;\n  line-height: 1.35;\n}\n.exec-metric-mid {\n  display: flex;\n  align-items: baseline;\n  justify-content: center;\n  gap: 6px;\n  margin: 3px 0;\n}\n.exec-metric-mid strong {\n  font-size: 24px !important;\n  font-weight: 900 !important;\n  line-height: 1 !important;\n}\n.exec-metric-foot {\n  font-size: 9.5px;\n  font-weight: 800;\n  text-align: center;\n}\n\n/* Bottom 3-column grid: Right=Latest Events, Middle=Projects Table, Left=Decision List */\n/* Wait: In main.png:\n   Leftmost panel = لیست تصمیم‌های ضروری مدیریت (with red circle 2)\n   Middle panel = پروژه‌های نیازمند توجه (table with 5 projects)\n   Rightmost panel = آخرین تحولات مهم (timeline with 4 events)\n   Because #homePage .bottom-grid has direction: rtl, column 1 is Rightmost, column 2 is Middle, column 3 is Leftmost!\n   Let's force direction: ltr on .bottom-grid so column 1 is Leftmost (Decisions), column 2 is Middle (Projects), column 3 is Rightmost (Latest Developments), matching main.png! */\n#homePage .bottom-grid {\n  display: grid !important;\n  grid-template-columns: minmax(0, 1.18fr) minmax(0, 1.05fr) minmax(245px, 0.72fr) !important;\n  gap: 12px !important;\n  direction: ltr !important;\n  align-items: stretch !important;\n}\n#homePage .bottom-grid > .panel {\n  direction: rtl !important;\n}\n#homePage .bottom-grid .decision-panel { grid-column: 1 !important; }\n#homePage .bottom-grid .project-panel { grid-column: 2 !important; }\n#homePage .bottom-grid .latest-panel { grid-column: 3 !important; }\n\n/* Rich Decision Cards matching main.png */\n.ref-decision-card {\n  border: 1px solid #f2cfd3;\n  border-radius: 8px;\n  padding: 9px 11px;\n  background: linear-gradient(90deg, #fff5f6 0%, #fff 60%);\n  display: grid;\n  grid-template-columns: 62px 86px minmax(0, 1fr) 128px 16px;\n  gap: 9px;\n  align-items: center;\n  direction: ltr;\n  cursor: pointer;\n  transition: box-shadow 0.15s ease;\n}\n.ref-decision-card:hover {\n  box-shadow: 0 4px 12px rgba(236, 28, 46, 0.1);\n}\n.ref-decision-card.orange {\n  border-color: #f6dfc2;\n  background: linear-gradient(90deg, #fffaf2 0%, #fff 60%);\n}\n.ref-dec-deadline {\n  text-align: center;\n  direction: rtl;\n}\n.ref-dec-deadline .pill-days {\n  display: block;\n  background: #ed1c2e;\n  color: #fff;\n  font-size: 11px;\n  font-weight: 900;\n  padding: 4px 6px;\n  border-radius: 5px;\n}\n.ref-decision-card.orange .ref-dec-deadline .pill-days {\n  background: #f58220;\n}\n.ref-dec-deadline small {\n  display: block;\n  font-size: 8.5px;\n  color: #5a7186;\n  margin-top: 3px;\n  font-weight: 700;\n}\n.ref-dec-thumb {\n  width: 86px;\n  height: 58px;\n  border-radius: 5px;\n  overflow: hidden;\n  border: 1px solid #d9e4ee;\n  background: #e9f1f7;\n  position: relative;\n}\n.ref-dec-thumb img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n.ref-dec-center {\n  direction: rtl;\n  text-align: right;\n  min-width: 0;\n}\n.ref-dec-center .p-code {\n  font-size: 10px;\n  font-weight: 800;\n  color: #395570;\n}\n.ref-dec-center strong {\n  display: block;\n  font-size: 12px;\n  font-weight: 900;\n  color: #0d2b4e;\n  margin: 1px 0 2px;\n}\n.ref-dec-center .p-sub {\n  font-size: 9.5px;\n  color: #5b7288;\n  margin-bottom: 5px;\n}\n.ref-dec-tags {\n  display: flex;\n  gap: 4px;\n  flex-wrap: wrap;\n}\n.ref-dec-tags span {\n  background: #e8f0f8;\n  color: #23496d;\n  font-size: 8.5px;\n  font-weight: 700;\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n.ref-dec-impacts {\n  direction: rtl;\n  text-align: right;\n  font-size: 9.5px;\n  color: #2a4765;\n  line-height: 1.55;\n  border-right: 1px solid #e6eef5;\n  padding-right: 8px;\n}\n.ref-dec-arrow {\n  color: #5c748a;\n  font-weight: 900;\n  font-size: 14px;\n  text-align: center;\n}\n\n/* Source ribbon subtle bar so Playwright test passes while keeping clean visual look */\n#homePage .source-ribbon {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 4px 12px;\n  margin: -6px 0 8px;\n  font-size: 9px;\n  background: #e5eff8;\n  border: 1px solid #d0e0ef;\n  border-radius: 6px;\n  color: #3c5a78;\n}\n.sr-compat-hooks {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n@media (max-width: 1250px) {\n  #homePage .kpis { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; }\n  #homePage .layout-main { grid-template-columns: minmax(0, 1fr) !important; direction: rtl !important; }\n  #homePage .bottom-grid { grid-template-columns: minmax(0, 1fr) !important; direction: rtl !important; }\n  #homePage .bottom-grid .decision-panel,\n  #homePage .bottom-grid .project-panel,\n  #homePage .bottom-grid .latest-panel { grid-column: auto !important; }\n}\n@media (max-width: 850px) {\n  .shell { grid-template-columns: 1fr !important; }\n  .sidebar { flex-direction: row !important; padding: 6px !important; overflow-x: auto !important; }\n  .sidebar-turbine-art { display: none !important; }\n  .risk-map-layout { grid-template-columns: 1fr !important; }\n  .ref-decision-card { grid-template-columns: 1fr !important; direction: rtl !important; }\n  #homePage .products-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }\n}\n/* Interactive hover feedback for all CEO Home Page live widgets */\n#homePage [data-nav-page] {\n  cursor: pointer !important;\n  transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease !important;\n}\n#homePage .kpi[data-nav-page]:hover,\n#homePage .product[data-nav-page]:hover,\n#homePage .executive-metric[data-nav-page]:hover {\n  transform: translateY(-2px) !important;\n  box-shadow: 0 6px 16px rgba(16, 47, 85, 0.11) !important;\n  border-color: #8ab6df !important;\n}\n#homePage .status-legend-item[data-nav-page] {\n  padding: 3px 5px;\n  border-radius: 5px;\n}\n#homePage .status-legend-item[data-nav-page]:hover,\n#homePage .size-legend-item[data-nav-page]:hover {\n  background: #eaf3fc;\n}\n#homePage .risk-chart circle[data-nav-page] {\n  cursor: pointer;\n  transition: opacity 0.15s ease, stroke-width 0.15s ease;\n}\n#homePage .risk-chart circle[data-nav-page]:hover {\n  opacity: 1 !important;\n  stroke: #0d2b4e;\n  stroke-width: 2.5px;\n}\n#homePage .project-table tbody tr[data-nav-page]:hover {\n  background: #edf5fc !important;\n}\n#homePage .timeline .event[data-nav-page] {\n  padding: 8px 6px !important;\n  border-radius: 6px;\n}\n#homePage .timeline .event[data-nav-page]:hover {\n  background: #f0f7fd;\n}\n.active-filter-banner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 10px 14px;\n  margin-bottom: 12px;\n  border-radius: 10px;\n  background: linear-gradient(90deg, #e6f2fc, #f4f9fd);\n  border: 1px solid #b8d6f0;\n  color: #0d3359;\n  font-size: 11.5px;\n}\n/* ================================================================\n   PVPT THEME STYLES (Dark & Factory)\n   ================================================================ */\n\n/* --- DARK THEME (تاریک / شب) --- */\n[data-theme=\"dark\"] body {\n  background: #091018 !important;\n  color: #e2edf8 !important;\n}\n[data-theme=\"dark\"] .topbar {\n  background: linear-gradient(90deg, #070e17 0%, #0d1a29 55%, #08111c 100%) !important;\n  border-bottom: 1px solid #1a2d42 !important;\n}\n[data-theme=\"dark\"] .sidebar {\n  background: linear-gradient(180deg, #09121c 0%, #060d14 100%) !important;\n  border-left: 1px solid #172a3e !important;\n}\n[data-theme=\"dark\"] .workspace {\n  background: #091018 !important;\n}\n[data-theme=\"dark\"] .panel,\n[data-theme=\"dark\"] .kpi,\n[data-theme=\"dark\"] .app-card,\n[data-theme=\"dark\"] .demo-card,\n[data-theme=\"dark\"] .ref-decision-card,\n[data-theme=\"dark\"] .product,\n[data-theme=\"dark\"] .executive-metric {\n  background: #111e2d !important;\n  border-color: #1e3247 !important;\n  color: #d6e4f0 !important;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35) !important;\n}\n[data-theme=\"dark\"] .panel-head {\n  background: linear-gradient(100deg, #132233, #0f1c2b) !important;\n  border-bottom-color: #1c3045 !important;\n}\n[data-theme=\"dark\"] .panel-head h2,\n[data-theme=\"dark\"] .kpi-head-title,\n[data-theme=\"dark\"] h1,\n[data-theme=\"dark\"] h2,\n[data-theme=\"dark\"] h3,\n[data-theme=\"dark\"] strong,\n[data-theme=\"dark\"] .m-title,\n[data-theme=\"dark\"] .p-code {\n  color: #e8f2fc !important;\n}\n[data-theme=\"dark\"] .product-name {\n  color: #dce7f2 !important;\n}\n[data-theme=\"dark\"] .product-visual {\n  background: linear-gradient(180deg, #152538, #0f1c2b) !important;\n}\n[data-theme=\"dark\"] .decision-card {\n  background: #142232 !important;\n  border-color: #233950 !important;\n  color: #e2edf8 !important;\n}\n[data-theme=\"dark\"] .decision-card.orange {\n  background: #1e2528 !important;\n  border-color: #3b3a32 !important;\n}\n[data-theme=\"dark\"] .modal {\n  background: #101c2b !important;\n  border: 1px solid #1e354e !important;\n  color: #e2edf8 !important;\n  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.7) !important;\n}\n[data-theme=\"dark\"] .modal-head {\n  border-bottom-color: #1e354e !important;\n}\n[data-theme=\"dark\"] .modal-warning {\n  background: #241d10 !important;\n  border-color: #584115 !important;\n  color: #f1c762 !important;\n}\n[data-theme=\"dark\"] .close {\n  background: #172a3e !important;\n  color: #a4bed6 !important;\n}\n[data-theme=\"dark\"] .active-filter-banner {\n  background: #122438 !important;\n  border-color: #1f3f63 !important;\n  color: #92bce6 !important;\n}\n[data-theme=\"dark\"] .app-subnav button {\n  background: #101e2e !important;\n  border-color: #1c3249 !important;\n  color: #93acc4 !important;\n}\n[data-theme=\"dark\"] .app-subnav button.active {\n  background: #2878cf !important;\n  color: #fff !important;\n}\n[data-theme=\"dark\"] .app-empty,\n[data-theme=\"dark\"] .app-stat,\n[data-theme=\"dark\"] .app-notice,\n[data-theme=\"dark\"] .app-flow-node {\n  background: #111f2e !important;\n  border-color: #1d334b !important;\n  color: #cbdbe8 !important;\n}\n[data-theme=\"dark\"] .app-btn.secondary,\n[data-theme=\"dark\"] .demo-btn.secondary {\n  background: #15273a !important;\n  border-color: #233c56 !important;\n  color: #cbdbe8 !important;\n}\n[data-theme=\"dark\"] .risk-chart text {\n  fill: #8ea8c0 !important;\n}\n[data-theme=\"dark\"] .risk-chart line {\n  stroke: #1b2f44 !important;\n}\n[data-theme=\"dark\"] .risk-chart rect[fill=\"#f3f7fb\"] {\n  fill: #111e2c !important;\n}\n[data-theme=\"dark\"] .risk-chart rect[fill=\"#f7fafd\"] {\n  fill: #0d1824 !important;\n}\n[data-theme=\"dark\"] .risk-chart rect[fill=\"#edf7f2\"] {\n  fill: #0c1d1a !important;\n}\n[data-theme=\"dark\"] .risk-chart rect[fill=\"#fde8ea\"] {\n  fill: #221217 !important;\n}\n[data-theme=\"dark\"] .hero {\n  background: linear-gradient(100deg, #101d2a 0%, #15273a 50%, #0d1a27 100%) !important;\n  border-color: #1e364e !important;\n}\n[data-theme=\"dark\"] .hero h1 {\n  color: #f0f6fc !important;\n}\n[data-theme=\"dark\"] .hero p {\n  color: #9ab4cc !important;\n}\n[data-theme=\"dark\"] .hero .metric-box {\n  background: #132435 !important;\n  border-color: #1f3954 !important;\n}\n[data-theme=\"dark\"] input,\n[data-theme=\"dark\"] select,\n[data-theme=\"dark\"] textarea {\n  background: #132336 !important;\n  border-color: #233952 !important;\n  color: #e2edf8 !important;\n}\n[data-theme=\"dark\"] table th {\n  background: #142436 !important;\n  color: #8da6bd !important;\n}\n[data-theme=\"dark\"] table td {\n  border-bottom-color: #1a2c3f !important;\n}\n\n/* --- FACTORY THEME (صنعتی / کارخانه‌ای) --- */\n[data-theme=\"factory\"] body {\n  background: #12161f !important;\n  color: #e6edf3 !important;\n}\n[data-theme=\"factory\"] .topbar {\n  background: linear-gradient(90deg, #0d1117 0%, #161b22 50%, #21262d 100%) !important;\n  border-bottom: 2px solid #f59e0b !important;\n}\n[data-theme=\"factory\"] .sidebar {\n  background: #0d1117 !important;\n  border-left: 1px solid #30363d !important;\n}\n[data-theme=\"factory\"] .workspace {\n  background: #12161f !important;\n}\n[data-theme=\"factory\"] .panel,\n[data-theme=\"factory\"] .kpi,\n[data-theme=\"factory\"] .app-card,\n[data-theme=\"factory\"] .demo-card,\n[data-theme=\"factory\"] .product,\n[data-theme=\"factory\"] .executive-metric {\n  background: #1c212a !important;\n  border: 1px solid #363d4a !important;\n  color: #e6edf3 !important;\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4) !important;\n}\n[data-theme=\"factory\"] .panel-head {\n  background: #161b22 !important;\n  border-bottom: 1px solid #30363d !important;\n}\n[data-theme=\"factory\"] .panel-head h2 {\n  color: #fbbf24 !important;\n}\n[data-theme=\"factory\"] .kpi-head-title {\n  color: #f59e0b !important;\n}\n[data-theme=\"factory\"] h1,\n[data-theme=\"factory\"] h2,\n[data-theme=\"factory\"] h3,\n[data-theme=\"factory\"] strong,\n[data-theme=\"factory\"] .m-title,\n[data-theme=\"factory\"] .p-code {\n  color: #f3f4f6 !important;\n}\n[data-theme=\"factory\"] .product-name {\n  color: #e5e7eb !important;\n}\n[data-theme=\"factory\"] .product-visual {\n  background: #232936 !important;\n  border: 1px solid #384152 !important;\n}\n[data-theme=\"factory\"] .kpi.kpi-var-highlight {\n  background: linear-gradient(180deg, #2a1518 0%, #1c212a 100%) !important;\n  border: 1.5px solid #ef4444 !important;\n}\n[data-theme=\"factory\"] .ref-decision-card,\n[data-theme=\"factory\"] .decision-card {\n  background: #1c212a !important;\n  border: 1px solid #3b4454 !important;\n  color: #f3f4f6 !important;\n}\n[data-theme=\"factory\"] .modal {\n  background: #161b22 !important;\n  border: 1px solid #f59e0b !important;\n  color: #f3f4f6 !important;\n  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.8) !important;\n}\n[data-theme=\"factory\"] .modal-head {\n  border-bottom-color: #30363d !important;\n}\n[data-theme=\"factory\"] .modal-warning {\n  background: #271f11 !important;\n  border-color: #634b17 !important;\n  color: #fcd34d !important;\n}\n[data-theme=\"factory\"] .close {\n  background: #21262d !important;\n  color: #f3f4f6 !important;\n}\n[data-theme=\"factory\"] .active-filter-banner {\n  background: #1e2430 !important;\n  border-color: #f59e0b !important;\n  color: #fef3c7 !important;\n}\n[data-theme=\"factory\"] .app-subnav button {\n  background: #161b22 !important;\n  border-color: #30363d !important;\n  color: #9ca3af !important;\n}\n[data-theme=\"factory\"] .app-subnav button.active {\n  background: #d97706 !important;\n  color: #fff !important;\n}\n[data-theme=\"factory\"] .app-empty,\n[data-theme=\"factory\"] .app-stat,\n[data-theme=\"factory\"] .app-notice,\n[data-theme=\"factory\"] .app-flow-node {\n  background: #161b22 !important;\n  border-color: #30363d !important;\n  color: #d1d5db !important;\n}\n[data-theme=\"factory\"] .app-btn.secondary,\n[data-theme=\"factory\"] .demo-btn.secondary {\n  background: #21262d !important;\n  border-color: #363d4a !important;\n  color: #f3f4f6 !important;\n}\n[data-theme=\"factory\"] .risk-chart text {\n  fill: #9ca3af !important;\n}\n[data-theme=\"factory\"] .risk-chart line {\n  stroke: #30363d !important;\n}\n[data-theme=\"factory\"] .risk-chart rect[fill=\"#f3f7fb\"] {\n  fill: #161b22 !important;\n}\n[data-theme=\"factory\"] .risk-chart rect[fill=\"#f7fafd\"] {\n  fill: #12161f !important;\n}\n[data-theme=\"factory\"] .risk-chart rect[fill=\"#edf7f2\"] {\n  fill: #0f1c15 !important;\n}\n[data-theme=\"factory\"] .risk-chart rect[fill=\"#fde8ea\"] {\n  fill: #221518 !important;\n}\n[data-theme=\"factory\"] .hero {\n  background: #161b22 !important;\n  border: 1px solid #30363d !important;\n}\n[data-theme=\"factory\"] .hero h1 {\n  color: #fbbf24 !important;\n}\n[data-theme=\"factory\"] .hero p {\n  color: #9ca3af !important;\n}\n[data-theme=\"factory\"] .hero .metric-box {\n  background: #21262d !important;\n  border-color: #363d4a !important;\n}\n[data-theme=\"factory\"] input,\n[data-theme=\"factory\"] select,\n[data-theme=\"factory\"] textarea {\n  background: #212631 !important;\n  border-color: #3b4454 !important;\n  color: #f3f4f6 !important;\n}\n[data-theme=\"factory\"] table th {\n  background: #161b22 !important;\n  color: #9ca3af !important;\n}\n[data-theme=\"factory\"] table td {\n  border-bottom-color: #2d3442 !important;\n}\n\n/* --- LTR STYLES FOR ENGLISH LANGUAGE --- */\nhtml[dir=\"ltr\"] body,\nhtml[dir=\"ltr\"] .workspace,\nhtml[dir=\"ltr\"] .topbar,\nhtml[dir=\"ltr\"] .shell {\n  direction: ltr !important;\n}\nhtml[dir=\"ltr\"] .shell {\n  grid-template-columns: 244px minmax(0, 1fr) !important;\n}\nhtml[dir=\"ltr\"] .sidebar {\n  border-left: none !important;\n  border-right: 1px solid rgba(255, 255, 255, 0.08) !important;\n}\nhtml[dir=\"ltr\"] .nav {\n  text-align: left !important;\n}\nhtml[dir=\"ltr\"] .nav.active {\n  box-shadow: inset 3px 0 #58c7e8 !important;\n}\nhtml[dir=\"ltr\"] .user {\n  border-right: none !important;\n  border-left: 1px solid #ffffff2a !important;\n  padding-right: 0 !important;\n  padding-left: 18px !important;\n}\nhtml[dir=\"ltr\"] .project-table th,\nhtml[dir=\"ltr\"] .project-table td,\nhtml[dir=\"ltr\"] .demo-table th,\nhtml[dir=\"ltr\"] .demo-table td,\nhtml[dir=\"ltr\"] .app-table th,\nhtml[dir=\"ltr\"] .app-table td {\n  text-align: left !important;\n}\nhtml[dir=\"ltr\"] .app-field span {\n  text-align: left !important;\n}\nhtml[dir=\"ltr\"] .decision-card {\n  border-right: 1px solid #f0d7d9 !important;\n  border-left: 4px solid var(--red) !important;\n}\n