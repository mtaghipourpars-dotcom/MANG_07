se:collapse;width:100%;min-width:600px;background:white;font-size:11px}.demo-table th,.demo-table td{padding:10px;border-bottom:1px solid var(--line);text-align:right;vertical-align:top}.demo-table th{background:#f2f6fa;color:#4f657a;font-weight:700;white-space:nowrap}.demo-table td{line-height:1.8}\n.metric-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(125px,1fr));gap:9px;margin:12px 0}.metric-box{background:#f7f9fc;border:1px solid var(--line);border-radius:9px;padding:10px}.metric-box span{display:block;font-size:10px;color:var(--muted)}.metric-box strong{display:block;font-size:17px;margin-top:5px}\n.demo-form{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin-top:12px}.demo-form label{display:grid;gap:5px;font-size:11px;color:#536a80}.demo-form input,.demo-form select,.demo-form textarea{width:100%;border:1px solid #d5e0eb;border-radius:8px;padding:9px;font:inherit;background:#fff;color:var(--ink)}\n@media(max-width:580px){.demo-table{min-width:540px}.metric-box strong{font-size:15px}}\n\n/* Reference-screen alignment: PARS executive cockpit */\n:root{--navy:#1c2c3d;--navy2:#20394f;--ink:#102f55;--muted:#647c91;--line:#dbe7f2;--bg:#edf4fa;--red:#ed1c2e;--orange:#ff8317;--amber:#f5b400;--green:#159b58;--blue:#1768b7;--purple:#6a1bb1;--shadow:0 2px 8px rgba(20,50,80,.035)}\nbody{font-size:13px;background:#edf4fa}\n.topbar{height:58px;padding:0 22px;background:linear-gradient(100deg,#192838,#243c53);box-shadow:none}\n.brandmark{width:40px;height:38px}.brandname{font-size:29px}.brandname small{font-size:8px}\n.shell{grid-template-columns:176px minmax(0,1fr);min-height:calc(100vh - 58px)}\n.sidebar{padding:34px 0 14px;gap:7px;background:linear-gradient(180deg,#1d2b38,#172838);border-radius:0}\n.nav{border-radius:0;padding:14px 17px;font-size:12px;min-height:48px}.nav .ico{font-size:21px;width:27px}.nav.active{background:linear-gradient(90deg,#214a6a,#245778);box-shadow:inset -4px 0 #44bce7}\n.side-caption{display:no